  "v3s table": {
    "prefix": "v3s-table",
    "body": [
      "<template>",
      "  <!-- ${1:业务说明} -->",
      "  <div>",
      "    <RhSearch :searchInfo=\"searchInfo\" @search=\"handleSearch\" />",
      "    <RhTable border stripe :loading=\"loading\" :table-data=\"tableData\" @pageChange=\"getList\" @pageSizeChange=\"pageSizeChange\">",
      "      <template #operate=\"{ scope }\">",
      "        <el-button type=\"primary\" link>操作</el-button>",
      "      </template>",
      "    </RhTable>",
      "  </div>",
      "</template>",
      "",
      "<script setup>",
      "import { onMounted, reactive, ref } from \"vue\";",
      "import { initSearchData } from \"@/utils/index.js\";",
      "// import { getList } from \"@/api/api.js\";",
      "",
      "// 条件配置",
      "const searchForm = ref({});",
      "const searchInfo = ref([",
      "  {",
      "    type: \"input\",",
      "    label: \"名称\",",
      "    placeholder: \"请输入名称\",",
      "    key: \"name\",",
      "    defaultValue: \"\"",
      "  },",
      "  {",
      "    type: \"select\",",
      "    label: \"类型\",",
      "    placeholder: \"请选择类型\",",
      "    key: \"type\",",
      "    defaultValue: \"\",",
      "    options: [",
      "      { value: \"1\", label: \"选项一\" },",
      "      { value: \"2\", label: \"选项二\" },",
      "    ]",
      "  },",
      "]);",
      "// 表格配置",
      "const tableData = reactive({",
      "  showOverflowTooltip: true,",
      "  columns: [",
      "    { label: \"序号\", type: \"index\" },",
      "    { label: \"日期\", prop: \"date\", minWidth: \"120px\" },",
      "    { label: \"姓名\", prop: \"name\", width: \"120px\" },",
      "    { label: \"操作\", prop: \"operate\", fixed: \"right\", width: \"200px\" },",
      "  ],",
      "  data: [",
      "    { date: \"2016-05-03\", name: \"$TM_FILENAME_BASE 示例数据\" },",
      "  ],",
      "  pages: { total: 0, pageNumber: 1, pageSize: 10 },",
      "});",
      "const loading = ref(false); // 加载状态",
      "",
      "// 组件挂载完成后执行",
      "onMounted(() => {",
      "  // searchForm.value = initSearchData(searchInfo.value);",
      "  // getList();",
      "});",
      "",
      "// 条件查询",
      "const handleSearch = params => {",
      "  searchForm.value = params;",
      "  getList(1);",
      "};",
      "",
      "// 列表查询",
      "const getList = pageNumber => {",
      "  loading.value = true;",
      "  const params = {",
      "    ${2:page}: pageNumber ? pageNumber : tableData.pages.pageNumber,",
      "    ${3:size}: tableData.pages.pageSize,",
      "    ...searchForm.value",
      "  }",
      "  fetchApi(params)",
      "    .then(res => {",
      "      if (res.code == 200) {",
      "        tableData.data = res.data.${4:list};",
      "        tableData.pages.total = res.data.${5:total};",
      "        tableData.pages.pageNumber = params.${2:page};",
      "      }",
      "    })",
      "    .finally(() => {",
      "      loading.value = false;",
      "    });",
      "};",
      "",
      "// 更变每页条数",
      "const pageSizeChange = pageSize => {",
      "  tableData.pages.pageSize = pageSize;",
      "  getList(1);",
      "};",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>",
      ""
    ],
    "description": "v3s table tamplate"
  },
  "v3s table with selection": {
    "prefix": "v3s-table-selection",
    "body": [
      "<template>",
      "  <!-- ${1:业务说明} -->",
      "  <div>",
      "    <RhSearch :searchInfo=\"searchInfo\" @search=\"handleSearch\" />",
      "    <RhTable",
      "      border",
      "      stripe",
      "      :loading=\"loading\"",
      "      :table-data=\"tableData\"",
      "      @pageChange=\"getList\"",
      "      @pageSizeChange=\"pageSizeChange\"",
      "      @selection-change=\"handleSelectionChange\"",
      "    >",
      "      <template #operate=\"{ scope }\">",
      "        <el-button type=\"primary\" link>操作</el-button>",
      "      </template>",
      "    </RhTable>",
      "  </div>",
      "</template>",
      "",
      "<script setup>",
      "import { onMounted, reactive, ref } from \"vue\";",
      "import { initSearchData } from \"@/utils/index.js\";",
      "// import { getList } from \"@/api/api.js\";",
      "",
      "// 条件配置",
      "const searchForm = ref({});",
      "const searchInfo = ref([",
      "  {",
      "    type: \"input\",",
      "    label: \"名称\",",
      "    placeholder: \"请输入名称\",",
      "    key: \"name\",",
      "    defaultValue: \"\"",
      "  },",
      "  {",
      "    type: \"select\",",
      "    label: \"类型\",",
      "    placeholder: \"请选择类型\",",
      "    key: \"type\",",
      "    defaultValue: \"\",",
      "    options: [",
      "      { value: \"1\", label: \"选项一\" },",
      "      { value: \"2\", label: \"选项二\" },",
      "    ]",
      "  },",
      "]);",
      "// 表格配置",
      "const selectable = (row, index) => {",
      "  if (index == 1) return false;",
      "  return true;",
      "};",
      "const tableData = reactive({",
      "  showOverflowTooltip: true,",
      "  columns: [",
      "    { type: \"selection\", selectable },",
      "    { label: \"序号\", type: \"index\" },",
      "    { label: \"日期\", prop: \"date\", minWidth: \"120px\" },",
      "    { label: \"姓名\", prop: \"name\", width: \"120px\" },",
      "    { label: \"操作\", prop: \"operate\", fixed: \"right\", width: \"200px\" },",
      "  ],",
      "  data: [",
      "    { date: \"2016-05-03\", name: \"$TM_FILENAME_BASE 示例数据\" },",
      "  ],",
      "  pages: { total: 0, pageNumber: 1, pageSize: 10 },",
      "});",
      "const multipleSelection = ref([]);",
      "const loading = ref(false); // 加载状态",
      "",
      "// 组件挂载完成后执行",
      "onMounted(() => {",
      "  // searchForm.value = initSearchData(searchInfo.value);",
      "  // getList();",
      "});",
      "",
      "// 条件查询",
      "const handleSearch = params => {",
      "  searchForm.value = params;",
      "  getList(1);",
      "};",
      "",
      "// 列表查询",
      "const getList = pageNumber => {",
      "  loading.value = true;",
      "  const params = {",
      "    ${2:page}: pageNumber ? pageNumber : tableData.pages.pageNumber,",
      "    ${3:size}: tableData.pages.pageSize,",
      "    ...searchForm.value",
      "  }",
      "  fetchApi(params)",
      "    .then(res => {",
      "      if (res.code == 200) {",
      "        tableData.data = res.data.${4:list};",
      "        tableData.pages.total = res.data.${5:total};",
      "        tableData.pages.pageNumber = params.${2:page};",
      "      }",
      "    })",
      "    .finally(() => {",
      "      loading.value = false;",
      "    });",
      "};",
      "",
      "// 更变每页条数",
      "const pageSizeChange = pageSize => {",
      "  tableData.pages.pageSize = pageSize;",
      "  getList(1);",
      "};",
      "",
      "// 多选",
      "const handleSelectionChange = val => {",
      "  console.log('选中行：', val)",
      "  multipleSelection.value = val;",
      "};",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>",
      ""
    ],
    "description": "v3s table with selection"
  },
  "v3s dialog template": {
    "prefix": "v3s-dialog",
    "body": [
      "<template>",
      "  <!-- 弹窗-${1:业务/功能描述} -->",
      "  <el-dialog v-model=\"dialogVisible\" v-bind=\"\\$attrs\" @opened=\"opened\" @closed=\"closed\">",
      "    示例弹窗",
      "    <template #footer>",
      "      <el-button @click=\"dialogVisible = false\">取消</el-button>",
      "      <el-button type=\"primary\" @click=\"dialogVisible = false\">确认</el-button>",
      "    </template>",
      "  </el-dialog>",
      "</template>",
      "",
      "<script setup>",
      "/** dialog START **/",
      "const emits = defineEmits([\"opened\", \"closed\", \"success\"]);",
      "const dialogVisible = defineModel();",
      "",
      "// 弹窗开启",
      "const opened = () => {",
      "  emits(\"opened\");",
      "};",
      "",
      "// 弹窗关闭",
      "const closed = () => {",
      "  resetData();",
      "  emits(\"closed\");",
      "  dialogVisible.value = false",
      "};",
      "",
      "// 重置数据",
      "const resetData = () => {};",
      "/** dialog END **/",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>",
      ""
    ],
    "description": "v3s dialog template"
  }
}
