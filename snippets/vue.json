  "v3s table": {
    "prefix": "v3s-table",
    "body": [
      "<template>",
      "  <!-- ${1:业务说明} -->",
      "  <RhSearch :search-info=\"searchInfo\" @search=\"handleSearch\" />",
      "  <RhTable border stripe :loading=\"loading\" :table-data=\"tableData\" @page-change=\"getList\" @page-size-change=\"pageSizeChange\">",
      "    <template #operate=\"{ scope }\">",
      "      <el-button type=\"primary\" link>操作</el-button>",
      "    </template>",
      "  </RhTable>",
      "</template>",
      "",
      "<script setup>",
      "import { onMounted, reactive, ref } from \"vue\";",
      "import { initSearchData } from \"@/utils/index.js\";",
      "// import { getList } from \"@/api/api.js\";",
      "",
      "// 条件配置",
      "const searchForm = ref({});",
      "const searchInfo = ref([",
      "  { type: \"input\", label: \"名称\", key: \"name\" },",
      "  { type: \"select\", label: \"类型\", key: \"type\", options: [] },",
      "  {",
      "    type: \"daterange\",",
      "    label: \"日期范围\",",
      "    startPlaceholder: \"开始日期\",",
      "    endPlaceholder: \"结束日期\",",
      "    key: \"time\",",
      "    startKey: \"startTime\",",
      "    endKey: \"endTime\",",
      "    defaultValue: [],",
      "  },",
      "]);",
      "// 表格配置",
      "const tableData = reactive({",
      "  showOverflowTooltip: false,",
      "  columns: [",
      "    { label: \"序号\", type: \"index\" },",
      "    { label: \"日期\", prop: \"date\" },",
      "    { label: \"姓名\", prop: \"name\" },",
      "    { label: \"操作\", prop: \"operate\", fixed: \"right\", width: \"200px\" },",
      "  ],",
      "  data: [",
      "    { date: \"2016-05-03\", name: \"$TM_FILENAME_BASE 示例数据\" },",
      "  ],",
      "  pages: { total: 0, pageNumber: 1, pageSize: 10 },",
      "});",
      "const loading = ref(false); // 加载状态",
      "",
      "// 组件挂载完成后执行",
      "onMounted(() => {",
      "  // searchForm.value = initSearchData(searchInfo.value);",
      "  // getList();",
      "});",
      "",
      "// 条件查询",
      "const handleSearch = params => {",
      "  searchForm.value = params;",
      "  getList(1);",
      "};",
      "",
      "// 列表查询",
      "const getList = pageNumber => {",
      "  loading.value = true;",
      "  const params = {",
      "    ${2:pageNum}: pageNumber ? pageNumber : tableData.pages.pageNumber,",
      "    ${3:pageSize}: tableData.pages.pageSize,",
      "    ...searchForm.value",
      "  }",
      "  fetchApi(params)",
      "    .then(res => {",
      "      if (res.code == 200) {",
      "        tableData.data = res.data.${4:list};",
      "        tableData.pages.total = res.data.${5:total};",
      "        tableData.pages.pageNumber = params.${2:pageNum};",
      "      }",
      "    })",
      "    .catch(() => {})",
      "    .finally(() => {",
      "      loading.value = false;",
      "    });",
      "};",
      "",
      "// 更变每页条数",
      "const pageSizeChange = pageSize => {",
      "  tableData.pages.pageSize = pageSize;",
      "  getList(1);",
      "};",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>",
      ""
    ],
    "description": "vue SFC with table and pagination"
  },
  "v3s table with selection": {
    "prefix": "v3s-table-selection",
    "body": [
      "<template>",
      "  <!-- ${1:业务说明} -->",
      "  <RhSearch :searchInfo=\"searchInfo\" @search=\"handleSearch\" />",
      "  <RhTable",
      "    stripe",
      "    :loading=\"loading\"",
      "    :table-data=\"tableData\"",
      "    @page-change=\"getList\"",
      "    @page-size-change=\"pageSizeChange\"",
      "    @selection-change=\"handleSelectionChange\"",
      "  >",
      "    <template #operate=\"{ scope }\">",
      "      <el-button type=\"primary\" link>操作</el-button>",
      "    </template>",
      "  </RhTable>",
      "</template>",
      "",
      "<script setup>",
      "import { onMounted, reactive, ref } from \"vue\";",
      "import { initSearchData } from \"@/utils/index.js\";",
      "// import { getList } from \"@/api/api.js\";",
      "",
      "// 条件配置",
      "const searchForm = ref({});",
      "const searchInfo = ref([",
      "  { type: \"input\", label: \"名称\", key: \"name\" },",
      "  { type: \"select\", label: \"类型\", key: \"type\", options: [] },",
      "  {",
      "    type: \"daterange\",",
      "    label: \"日期范围\",",
      "    startPlaceholder: \"开始日期\",",
      "    endPlaceholder: \"结束日期\",",
      "    key: \"time\",",
      "    startKey: \"startTime\",",
      "    endKey: \"endTime\",",
      "    defaultValue: [],",
      "  },",
      "]);",
      "// 表格配置",
      "const selectable = (row, index) => {",
      "  if (index == 1) return false;",
      "  return true;",
      "};",
      "const tableData = reactive({",
      "  showOverflowTooltip: false,",
      "  columns: [",
      "    { type: \"selection\", selectable },",
      "    { label: \"序号\", type: \"index\" },",
      "    { label: \"日期\", prop: \"date\" },",
      "    { label: \"姓名\", prop: \"name\" },",
      "    { label: \"操作\", prop: \"operate\", fixed: \"right\", width: \"200px\" },",
      "  ],",
      "  data: [",
      "    { date: \"2016-05-03\", name: \"$TM_FILENAME_BASE 示例数据\" },",
      "  ],",
      "  pages: { total: 0, pageNumber: 1, pageSize: 10 },",
      "});",
      "const multipleSelection = ref([]);",
      "const loading = ref(false); // 加载状态",
      "",
      "// 组件挂载完成后执行",
      "onMounted(() => {",
      "  // searchForm.value = initSearchData(searchInfo.value);",
      "  // getList();",
      "});",
      "",
      "// 条件查询",
      "const handleSearch = params => {",
      "  searchForm.value = params;",
      "  getList(1);",
      "};",
      "",
      "// 列表查询",
      "const getList = pageNumber => {",
      "  loading.value = true;",
      "  const params = {",
      "    ${2:pageNum}: pageNumber ? pageNumber : tableData.pages.pageNumber,",
      "    ${3:pageSize}: tableData.pages.pageSize,",
      "    ...searchForm.value",
      "  }",
      "  fetchApi(params)",
      "    .then(res => {",
      "      if (res.code == 200) {",
      "        tableData.data = res.data.${4:list};",
      "        tableData.pages.total = res.data.${5:total};",
      "        tableData.pages.pageNumber = params.${2:pageNum};",
      "      }",
      "    })",
      "    .catch(() => {})",
      "    .finally(() => {",
      "      loading.value = false;",
      "    });",
      "};",
      "",
      "// 更变每页条数",
      "const pageSizeChange = pageSize => {",
      "  tableData.pages.pageSize = pageSize;",
      "  getList(1);",
      "};",
      "",
      "// 多选",
      "const handleSelectionChange = val => {",
      "  console.log('选中行：', val)",
      "  multipleSelection.value = val;",
      "};",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>",
      ""
    ],
    "description": "vue SFC with table, pagination and selection"
  },
  "v3s dialog template": {
    "prefix": "v3s-dialog",
    "body": [
      "<template>",
      "  <!-- 弹窗-${1:业务/功能描述} -->",
      "  <el-dialog v-model=\"dialogVisible\" v-bind=\"\\$attrs\" :close-on-click-modal=\"false\" @opened=\"opened\" @closed=\"closed\">",
      "    示例弹窗",
      "    <template #footer>",
      "      <el-button @click=\"dialogVisible = false\">取消</el-button>",
      "      <el-button type=\"primary\" @click=\"dialogVisible = false\">确认</el-button>",
      "    </template>",
      "  </el-dialog>",
      "</template>",
      "",
      "<script setup>",
      "const emits = defineEmits([\"opened\", \"closed\", \"success\"]);",
      "",
      "/** dialog START **/",
      "const dialogVisible = defineModel();",
      "",
      "// 弹窗开启",
      "const opened = () => {",
      "  emits(\"opened\");",
      "};",
      "",
      "// 弹窗关闭",
      "const closed = () => {",
      "  resetData();",
      "  emits(\"closed\");",
      "};",
      "",
      "// 重置数据",
      "const resetData = () => {};",
      "/** dialog END **/",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>",
      ""
    ],
    "description": "vue SFC with el-dialog"
  },
  "v3s dialog form template": {
    "prefix": "v3s-dialog-form",
    "body": [
      "<template>",
      "  <!-- 弹窗-${1:业务/功能描述} -->",
      "  <el-dialog v-model=\"dialogVisible\" v-bind=\"\\$attrs\" :close-on-click-modal=\"false\" @opened=\"opened\" @closed=\"closed\">",
      "    <el-form ref=\"ruleFormRef\" :model=\"ruleForm\" :rules=\"rules\" label-width=\"auto\" label-position=\"top\" status-icon>",
      "      <el-form-item label=\"名称\" prop=\"name\">",
      "        <el-input v-model=\"ruleForm.name\" placeholder=\"请输入\" />",
      "      </el-form-item>",
      "    </el-form>",
      "",
      "    <template #footer>",
      "      <el-button @click=\"dialogVisible = false\">取消</el-button>",
      "      <el-button type=\"primary\" :loading=\"submitLoading\" @click=\"submitForm\">确认</el-button>",
      "    </template>",
      "  </el-dialog>",
      "</template>",
      "",
      "<script setup>",
      "import { reactive, ref, useTemplateRef } from \"vue\";",
      "",
      "const dialogVisible = defineModel();",
      "",
      "const props = defineProps({",
      "\tdetail: { type: Object, default: () => ({}) },",
      "});",
      "",
      "const emits = defineEmits([\"opened\", \"closed\", \"success\"]);",
      "",
      "/** el-form START **/",
      "const ruleFormRef = useTemplateRef('ruleFormRef');",
      "const getInitialForm = () => ({",
      "  name: \"\",",
      "});",
      "const ruleForm = reactive(getInitialForm());",
      "const rules = reactive({",
      "  name: [{ required: true, message: \"请输入名称\", trigger: [\"blur\", \"change\"] }],",
      "});",
      "const getInitialState = () => ({",
      "  list: [],",
      "});",
      "const state = reactive(getInitialState());",
      "const submitLoading = ref(false)",
      "",
      "// 提交表单",
      "const submitForm = async () => {",
      "\tif (!ruleFormRef.value) return;",
      "\tawait ruleFormRef.value.validate((valid, fields) => {",
      "\t\tif (valid) {",
      "\t\t\tif (props.detail?.id) {",
      "\t\t\t\thandleEdit()\t// 编辑",
      "\t\t\t} else {",
      "\t\t\t\thandleAdd()\t// 添加",
      "\t\t\t}",
      "\t\t}",
      "\t});",
      "};",
      "",
      "// 添加",
      "const handleAdd = async (params) => {",
      "\tsubmitLoading.value = true;",
      "\ttry {",
      "\t\tconst res = await addApi(params);",
      "\t\tif (res.status == 1) {",
      "\t\t\tElMessage({ message: \"添加成功\", type: \"success\" });",
      "\t\t\temits(\"success\");",
      "\t\t\tdialogVisible.value = false;",
      "\t\t}",
      "\t} catch (error) {",
      "\t} finally {",
      "\t\tsubmitLoading.value = true;",
      "\t}",
      "};",
      "",
      "// 编辑",
      "const handleEdit = async (params) => {",
      "\tsubmitLoading.value = true;",
      "\ttry {",
      "\t\tconst res = await editApi({id, ...params});",
      "\t\tif (res.status == 1) {",
      "\t\t\tElMessage({ message: \"编辑成功\", type: \"success\" });",
      "\t\t\temits(\"success\");",
      "\t\t\tdialogVisible.value = false;",
      "\t\t}",
      "\t} catch (error) {",
      "\t} finally {",
      "\t\tsubmitLoading.value = true;",
      "\t}",
      "};",
      "",
      "// 获取详情",
      "const getDetail = async () => {",
      "\ttry {",
      "\t\tconst res = await detailApi({ id: props.detail.id });",
      "\t\tif (res.status == 1) {",
      "\t\t\tObject.keys(ruleForm).forEach(key => {",
      "\t\t\t\tif (key in res.data) ruleForm[key] = res.data[key];",
      "\t\t\t});",
      "\t\t}",
      "\t} catch (error) {",
      "\t} finally {",
      "\t}",
      "};",
      "/** el-form END **/",
      "",
      "/** dialog START **/",
      "// 弹窗开启",
      "const opened = () => {",
      "  emits(\"opened\");",
      "};",
      "",
      "// 弹窗关闭",
      "const closed = () => {",
      "  resetForm();",
      "  emits(\"closed\");",
      "};",
      "",
      "// 重置数据",
      "const resetForm = () => {",
      "  Object.assign(ruleForm, getInitialForm());",
      "  Object.assign(state, getInitialState());",
      "  ruleFormRef.value?.clearValidate();",
      "};",
      "/** dialog END **/",
      "</script>",
      "",
      "<style lang=\"scss\" scoped></style>",
      ""
    ],
    "description": "vue SFC with el-dialog and el-form (auto reset)"
  }
}