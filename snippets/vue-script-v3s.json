{
  "use v3s dialog": {
    "prefix": "v3s-usedialog",
    "body": [
      "// <el-button @click=\"showDialog\">点击弹窗</el-button>",
      "// <!-- 弹窗-用途 -->",
      "// <Dialog v-model=\"dialogVisible\" title=\"自定义标题\" width=\"700px\" />",
      "",
      "import { ref } from \"vue\";",
      "import Dialog from \"./dialog.vue\";",
      "",
      "/** 弹窗 START **/",
      "const dialogVisible = ref(false); // 弹窗显示/隐藏",
      "",
      "// 显示弹窗",
      "const showDialog = () => {",
